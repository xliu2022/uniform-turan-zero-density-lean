module

public import UniformTuran.Probability.HypergraphLaw
public import UniformTuran.Probability.FiniteProducts
public import UniformTuran.Probability.FiniteModels
public import UniformTuran.Probability.DisjointCoordinates
public import UniformTuran.Probability.ForbiddenPatterns

/-!
# Finite random hypergraphs generated by independent high-face labels

After the labels below level `q` are fixed, the random inputs in Claim 3.4
are independently sampled labels on sets of sizes `q, ..., r - 1`. Each edge
is determined by exactly the labels on its own subsets. The definitions here
implement that finite random experiment, allowing the label spaces to depend
on the face.

Author and maintainer: Xizhi Liu.
-/

public section

open scoped BigOperators

namespace UniformTuran

noncomputable section

namespace HighFaceGenerator

/-- Random input coordinates at the levels not fixed by the lower address. -/
abbrev HighFace (q r n : ℕ) :=
  {s : Finset (Fin n) // q ≤ s.card ∧ s.card < r}

/-- The input coordinates used to decide one candidate edge. -/
@[expose] def edgeInputs {q r n : ℕ} (e : RSubset r n) : Finset (HighFace q r n) :=
  Finset.univ.filter (fun s => s.val ⊆ e.val)

@[simp] theorem mem_edgeInputs {q r n : ℕ} {e : RSubset r n}
    {s : HighFace q r n} : s ∈ edgeInputs e ↔ s.val ⊆ e.val := by
  simp [edgeInputs]

/-- All coordinates inspected by an entire family of candidate edges. -/
@[expose] def familyInputs {q r n : ℕ} (E : Finset (RSubset r n)) :
    Finset (HighFace q r n) := E.biUnion edgeInputs

@[simp] theorem mem_familyInputs {q r n : ℕ} {E : Finset (RSubset r n)}
    {s : HighFace q r n} : s ∈ familyInputs E ↔ ∃ e ∈ E, s.val ⊆ e.val := by
  simp [familyInputs]

theorem edgeInputs_subset_familyInputs {q r n : ℕ} {E : Finset (RSubset r n)}
    {e : RSubset r n} (he : e ∈ E) : edgeInputs (q := q) e ⊆ familyInputs E := by
  intro s hs
  exact mem_familyInputs.mpr ⟨e, he, mem_edgeInputs.mp hs⟩

/-- Disjoint `q`-shadows give disjoint sets of random input coordinates,
including every level strictly above `q`. -/
theorem familyInputs_disjoint {q r n : ℕ} {E F : Finset (RSubset r n)}
    (hEF : ShadowDisjoint q E F) :
    Disjoint (familyInputs (q := q) E) (familyInputs F) := by
  apply Finset.disjoint_left.mpr
  intro s hsE hsF
  obtain ⟨e, he, hse⟩ := mem_familyInputs.mp hsE
  obtain ⟨f, hf, hsf⟩ := mem_familyInputs.mp hsF
  have hc := Finset.card_le_card (Finset.subset_inter hse hsf)
  exact (not_lt_of_ge (s.property.1.trans hc)) (hEF e he f hf)

variable {q r n : ℕ}
variable {Cell : HighFace q r n → Type*}

/-- The labels relevant to one edge, with their face-dependent value types. -/
abbrev LocalLabels (Cell : HighFace q r n → Type*) (e : RSubset r n) :=
  (s : ↥(edgeInputs (q := q) e)) → Cell s.val

/-- An arbitrary deterministic edge decision based on its own face labels. -/
abbrev LocalRule (Cell : HighFace q r n → Type*) :=
  (e : RSubset r n) → LocalLabels Cell e → Bool

/-- Evaluate every local rule against one global independent-label sample. -/
@[expose] def configuration (rule : LocalRule Cell)
    (labels : (s : HighFace q r n) → Cell s) : Configuration r n :=
  fun e => rule e (fun s => labels s.val)

@[simp] theorem configuration_apply (rule : LocalRule Cell)
    (labels : (s : HighFace q r n) → Cell s) (e : RSubset r n) :
    configuration rule labels e = rule e (fun s => labels s.val) := rfl

/-- Decode a complete edge-indicator vector using only the coordinates in its
edge family's input set. -/
@[expose] def familyConfiguration (rule : LocalRule Cell)
    (E : Finset (RSubset r n))
    (labels : (s : ↥(familyInputs (q := q) E)) → Cell s.val) : ↥E → Bool :=
  fun e => rule e.val (fun s =>
    labels ⟨s.val, edgeInputs_subset_familyInputs e.property s.property⟩)

theorem familyConfiguration_restrict (rule : LocalRule Cell)
    (E : Finset (RSubset r n)) (labels : (s : HighFace q r n) → Cell s) :
    familyConfiguration rule E (fun s => labels s.val) =
      fun e : ↥E => configuration rule labels e.val := rfl

variable [∀ s, Fintype (Cell s)]

/-- The finite configuration law obtained by sampling every face label
independently and applying the local edge rules. -/
@[expose] def law (ρ : (s : HighFace q r n) → Probability.FinLaw (Cell s))
    (rule : LocalRule Cell) : Probability.FinLaw (Configuration r n) :=
  (Probability.FinLaw.pi ρ).map (configuration rule)

theorem expect_law (ρ : (s : HighFace q r n) → Probability.FinLaw (Cell s))
    (rule : LocalRule Cell) (f : Configuration r n → ℝ) :
    (law ρ rule).expect f =
      (Probability.FinLaw.pi ρ).expect (fun labels => f (configuration rule labels)) :=
  Probability.FinLaw.expect_map _ _ _

/-- The generator has mutual independence of complete edge-indicator vectors
whenever their `q`-shadows are pairwise disjoint. This is the independence
assertion in Claim 3.4(iii). -/
theorem law_shadowIndependent
    (ρ : (s : HighFace q r n) → Probability.FinLaw (Cell s))
    (rule : LocalRule Cell) : (law ρ rule).ShadowIndependent q := by
  intro k E hE f
  have hInd := Probability.FinLaw.independent_pi_disjoint_functions ρ
    (fun i : Fin k => familyInputs (q := q) (E i))
    (fun i j hij => familyInputs_disjoint (hE i j hij))
    (fun i => familyConfiguration rule (E i))
  have hf := hInd f
  simp only [familyConfiguration_restrict] at hf
  calc
    _ = (Probability.FinLaw.pi ρ).expect (fun labels =>
        ∏ i, f i (fun e : ↥(E i) => configuration rule labels e.val)) :=
      expect_law ρ rule _
    _ = ∏ i, (Probability.FinLaw.pi ρ).expect
        (fun labels => f i (fun e : ↥(E i) => configuration rule labels e.val)) := hf
    _ = _ := by
      apply Finset.prod_congr rfl
      intro i _
      exact (expect_law ρ rule
        (fun x => f i (fun e : ↥(E i) => x e.val))).symm

/-- Pointwise freeness established by a deterministic embedding argument
becomes avoidance of every labelled forbidden pattern by the generated law.
This lemma does not assert the regularity embedding argument itself. -/
theorem law_avoids_of_isFree {m : ℕ}
    (ρ : (s : HighFace q r n) → Probability.FinLaw (Cell s))
    (rule : LocalRule Cell) (F : UHypergraph r (Fin m))
    (hfree : ∀ labels, UHypergraph.IsFree F (configuration rule labels).toHypergraph) :
    (law ρ rule).Avoids F := by
  intro g
  exact Probability.FinLaw.expect_generated_pattern_eq_zero_of_isFree
    (Probability.FinLaw.pi ρ) (configuration rule) F g hfree

/-- Independent uniform labels with the prescribed number of cells at each
level, exactly as in Claim 3.4(ii). -/
@[expose] def uniformLabelLaws (a : ℕ → ℕ)
    (ha : ∀ s : HighFace q r n, 0 < a s.val.card) :
    (s : HighFace q r n) → Probability.FinLaw (Fin (a s.val.card)) := by
  intro s
  letI : Nonempty (Fin (a s.val.card)) := ⟨⟨0, ha s⟩⟩
  exact Probability.FinLaw.uniform _

end HighFaceGenerator
end
end UniformTuran
